# ========================================================
# Digitoppers Core Backend - Environment Configuration
# ========================================================

# Server Runtime
NODE_ENV=production
PORT=3001
BASE_URL=https://<your-render-service-name>.onrender.com
BASE_URL_FORWARDED=https://<your-render-service-name>.onrender.com

# CORS Configuration (Set to * or comma-separated origins)
# Examples: "*" OR ["https://dashboard.digitoppers.in","https://your-frontend.netlify.app"]
ALLOWED_ORIGINS=["*"]

# MongoDB Connection String (MongoDB Atlas)
# You can set MONGODB_URI or MONGO_URI_PROD
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digitoppers_db_core?retryWrites=true&w=majority
MONGO_URI_PROD=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digitoppers_db_core?retryWrites=true&w=majority
MONGO_URI_DEV=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digitoppers_db_core?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=super_secret_jwt_key_digitoppers_core_2026

# Storage & Updates
STORAGE_DRIVER=local
LOCAL_BUNDLES_DIR=storage
DOWNLOAD_TOKEN_SECRET=dev-secret-download-token
BUNDLE_UPLOAD_MAX_MB=2048

# AWS S3 (Optional - only required if STORAGE_DRIVER=s3)
S3_REGION=ap-south-1
S3_BUCKET=digitopper-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Project Tracker Operations Integration
TRACKER_BACKEND_URL=https://<tracker-backend>.onrender.com
INTERNAL_SERVICE_SECRET=tracker_core_shared_secret_2026
